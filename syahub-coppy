    btn.TextColor3 = (name == currentFormat) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(150, 150, 160)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)
    formatBtns[name] = btn

    btn.Activated:Connect(function()
        currentFormat = name
        for n, b in pairs(formatBtns) do
            b.BackgroundColor3 = (n == currentFormat) and Color3.fromRGB(50, 50, 60) or Color3.fromRGB(15, 17, 22)
            b.TextColor3 = (n == currentFormat) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(150, 150, 160)
        end
    end)
end
