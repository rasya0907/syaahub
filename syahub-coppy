    btn.Text = ""
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    Instance.new("UIStroke", btn).Color = Color3.fromRGB(60, 60, 70)
    
    local checkImg = Instance.new("ImageLabel", btn)
    checkImg.Size = UDim2.new(0, 14, 0, 14)
    checkImg.Position = UDim2.new(0.5, -7, 0.5, -7)
    checkImg.BackgroundTransparency = 1
    checkImg.Image = finalCheckIcon
    checkImg.ScaleType = Enum.ScaleType.Fit
    checkImg.Visible = defaultState

    task.spawn(function()
        if type(getcustomasset) == "function" then
            while not isfile(checkFileName) do task.wait(0.5) end
            pcall(function() checkImg.Image = getcustomasset(checkFileName) end)
        end
    end)
    
    local lbl = Instance.new("TextLabel", frame)
    lbl.Size = UDim2.new(1, -35, 1, 0)
    lbl.Position = UDim2.new(0, 32, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = Color3.fromRGB(220, 220, 220)
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    
    local state = defaultState
    btn.Activated:Connect(function()
        state = not state
        btn.BackgroundColor3 = state and Color3.fromRGB(0, 130, 255) or Color3.fromRGB(30, 30, 35)
        checkImg.Visible = state
    end)
    return function() return state end
end

