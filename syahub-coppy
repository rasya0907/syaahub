-- SISTEM NOTIFIKASI SLIDE (KANAN ATAS)
-- ==========================================
local NotifGui = Instance.new("ScreenGui")
NotifGui.Name = "SyaaCustomNotif"
NotifGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
NotifGui.Parent = CoreGui

local activeNotifs = 0
local function showNotification(text, mode)
    local yOffset = 20 + (activeNotifs * 50)
    activeNotifs = activeNotifs + 1
    
    local NotifFrame = Instance.new("Frame")
    NotifFrame.Size = UDim2.new(0, 240, 0, 40)
    NotifFrame.Position = UDim2.new(1, 20, 0, yOffset) -- Mulai dari luar layar (Kanan)
    NotifFrame.BackgroundColor3 = Color3.fromRGB(20, 22, 28)
    Instance.new("UICorner", NotifFrame).CornerRadius = UDim.new(0, 8)
    
    local stroke = Instance.new("UIStroke", NotifFrame)
    stroke.Thickness = 1.5
    
    local icon = "⏳"
    if mode == "success" then
        stroke.Color = Color3.fromRGB(0, 255, 120)
        icon = "✅"
    elseif mode == "error" then
        stroke.Color = Color3.fromRGB(255, 80, 80)
        icon = "❌"
    else
        stroke.Color = Color3.fromRGB(0, 130, 255)
    end

    local lbl = Instance.new("TextLabel", NotifFrame)
    lbl.Size = UDim2.new(1, -20, 1, 0)
    lbl.Position = UDim2.new(0, 10, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = icon .. " " .. text
    lbl.TextColor3 = Color3.fromRGB(230, 230, 230)
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextWrapped = true

    NotifFrame.Parent = NotifGui

    -- Animasi Masuk (Slide In)
    local tweenIn = TweenService:Create(NotifFrame, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(1, -260, 0, yOffset)})
    tweenIn:Play()
    
    -- Tunggu 3 detik terus keluar
    task.delay(3, function()
        -- Animasi Keluar (Slide Out)
        local tweenOut = TweenService:Create(NotifFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In), {Position = UDim2.new(1, 20, 0, yOffset)})
        tweenOut:Play()
        tweenOut.Completed:Wait()
        NotifFrame:Destroy()
        activeNotifs = activeNotifs - 1
    end)
end

