local function createTab(name)
    local btn = Instance.new("TextButton", TabContainer)
    btn.Size = UDim2.new(0.46, 0, 0.8, 0)
    btn.BackgroundColor3 = (name == currentFormat) and Color3.fromRGB(50, 50, 60) or Color3.fromRGB(15, 17, 22)
