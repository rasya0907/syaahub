        Position = UDim2.new(0.5, -210, 0.5, -145),
        GroupTransparency = 1
    })
    twOut:Play()
    twOut.Completed:Wait()
    IntroGui:Destroy()

    MainFrame.Visible = true
    MainFrame.Size = UDim2.new(0, 440, 0, 270)
    MainFrame.Position = UDim2.new(0.5, -220, 0.5, -145)
    MainFrame.GroupTransparency = 1
    MainStroke.Transparency = 1 -- Sembunyikan stroke duluan

    local twIn = TweenService:Create(MainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
        Position = UDim2.new(0.5, -220, 0.5, -135),
        GroupTransparency = 0
    })
    twIn:Play()
    
    -- Munculin stroke barengan sama frame
    TweenService:Create(MainStroke, TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Transparency = 0}):Play()
    
    showNotification()
end

