-- ==========================================
-- 9. TAB CLICK & FILE SCAN LOGIC
-- ==========================================
local scannedFilesData = {}
local renderFileList

for name, btn in pairs(tabButtons) do
    btn.MouseButton1Click:Connect(function()
        currentTab = name
        for tName, tBtn in pairs(tabButtons) do
            local stroke = tBtn:FindFirstChildOfClass("UIStroke")
            if tName == currentTab then
                TweenService:Create(tBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(0, 130, 255)}):Play()
                tBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                if stroke then stroke.Color = Color3.fromRGB(0, 130, 255) end
            else
                TweenService:Create(tBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(20, 24, 32)}):Play()
                tBtn.TextColor3 = Color3.fromRGB(160, 170, 190)
                if stroke then stroke.Color = Color3.fromRGB(40, 45, 55) end
            end
        end
        if #scannedFilesData > 0 then
            renderFileList()
        end
    end)
end

renderFileList = function()
    for _, child in pairs(FileList:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextLabel") then child:Destroy() end
    end

    local shownCount = 0
    for _, fileInfo in ipairs(scannedFilesData) do
        local fileName = fileInfo.name
        local fullPath = fileInfo.path

        if fileName:match(currentTab:gsub("%.", "%%.") .. "$") then
            shownCount = shownCount + 1
            local ItemFrame = Instance.new("Frame")
            ItemFrame.Size = UDim2.new(0.97, 0, 0, 32)
            ItemFrame.BackgroundColor3 = Color3.fromRGB(20, 24, 32)
            ItemFrame.BackgroundTransparency = 0.2
            ItemFrame.ZIndex = 3
            ItemFrame.Parent = FileList

            local ItemCorner = Instance.new("UICorner")
            ItemCorner.CornerRadius = UDim.new(0, 6)
            ItemCorner.Parent = ItemFrame

            -- MENGGANTI TEXT "///" DENGAN ICON FOLDER
            local IconLabel = Instance.new("ImageLabel")
            IconLabel.Size = UDim2.new(0, 16, 0, 16)
            IconLabel.Position = UDim2.new(0, 8, 0.5, -8)
            IconLabel.BackgroundTransparency = 1
            IconLabel.ZIndex = 4
            if isfile(folderIconFileName) then
                pcall(function() IconLabel.Image = getcustomasset(folderIconFileName) end)
            end
            IconLabel.Parent = ItemFrame

            local TextClip = Instance.new("Frame")
            TextClip.Size = UDim2.new(1, -90, 1, 0)
            TextClip.Position = UDim2.new(0, 26, 0, 0)
            TextClip.BackgroundTransparency = 1
            TextClip.ClipsDescendants = true
            TextClip.ZIndex = 4
            TextClip.Parent = ItemFrame

            local NameLabel = Instance.new("TextLabel")
            NameLabel.Size = UDim2.new(2, 0, 1, 0)
            NameLabel.Position = UDim2.new(0, 0, 0, 0)
            NameLabel.BackgroundTransparency = 1
            NameLabel.Text = fileName
            NameLabel.TextColor3 = Color3.fromRGB(235, 235, 240)
            NameLabel.TextXAlignment = Enum.TextXAlignment.Left
            NameLabel.Font = Enum.Font.GothamMedium
            NameLabel.TextSize = 11
            NameLabel.ZIndex = 4
            NameLabel.Parent = TextClip

            task.spawn(function()
                task.wait(1)
                if NameLabel and NameLabel.Parent and NameLabel.TextBounds.X > TextClip.AbsoluteSize.X then
                    while NameLabel and NameLabel.Parent do
                        local tw = TweenService:Create(NameLabel, TweenInfo.new(4, Enum.EasingStyle.Linear), {Position = UDim2.new(-1, 0, 0, 0)})
                        tw:Play()
                        tw.Completed:Wait()
                        NameLabel.Position = UDim2.new(0, 0, 0, 0)
                        task.wait(1.5)
                    end
                end
            end)

            local ActionBtn = Instance.new("TextButton")
            ActionBtn.Size = UDim2.new(0, 68, 0, 23)
            ActionBtn.Position = UDim2.new(1, -72, 0.5, -11.5)
            ActionBtn.BackgroundColor3 = Color3.fromRGB(0, 130, 240)
            ActionBtn.Text = "Pasang"
            ActionBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            ActionBtn.Font = Enum.Font.GothamBold
            ActionBtn.TextSize = 11
            ActionBtn.ZIndex = 4
            ActionBtn.Parent = ItemFrame

            local ActionCorner = Instance.new("UICorner")
            ActionCorner.CornerRadius = UDim.new(0, 5)
            ActionCorner.Parent = ActionBtn

            ActionBtn.MouseButton1Click:Connect(function()
                ActionBtn.Text = "Loading..."
                ActionBtn.BackgroundColor3 = Color3.fromRGB(180, 120, 0)
                
                task.spawn(function()
                    local success, err = pcall(function()
                        if not getcustomasset or not httpRequest or not readfile or not writefile then
                            error("Executor kurang fitur!")
                        end
                        
                        local rawContent = readfile(fullPath)
                        local isPlaceFile = fileName:match("%.rbxlx$") or fileName:match("%.rbxl$")
                        local finalFileName = fileName
                        
                        if isPlaceFile then
                            ActionBtn.Text = "Convert API..."
                            local response = httpRequest({
                                Url = "https://syaabot.my.id/v1/roblox/convert", 
                                Method = "POST",
                                Headers = { ["Content-Type"] = "application/octet-stream" },
                                Body = rawContent
                            })
                            
                            if response.StatusCode == 200 then
                                finalFileName = "Clean_" .. fileName:gsub("%.rbxlx$", ".rbxmx"):gsub("%.rbxl$", ".rbxmx")
                                writefile(finalFileName, response.Body)
                            else
                                local successDecode, decoded = pcall(function()
                                    return HttpService:JSONDecode(response.Body)
                                end)
                                if successDecode and decoded and decoded.error then
                                    error("API: " .. tostring(decoded.error))
                                else
                                    error("Server API Error: Code " .. tostring(response.StatusCode))
                                end
                            end
                        end
                        
                        ActionBtn.Text = "Injecting..."
                        local assetUrl = getcustomasset(finalFileName)
                        local objects = game:GetObjects(assetUrl)
                        
                        for _, obj in pairs(objects) do
                            pcall(function() obj.Parent = workspace end)
                        end
                    end)
                    
                    if success then
                        ActionBtn.Text = "Berhasil!"
                        ActionBtn.BackgroundColor3 = Color3.fromRGB(0, 160, 80)
                    else
                        ActionBtn.Text = "Gagal"
                        ActionBtn.BackgroundColor3 = Color3.fromRGB(210, 60, 60)
                        warn("Syaa Hub Error: " .. tostring(err))
                    end
                    
                    task.wait(2.5)
                    ActionBtn.Text = "Pasang"
                    ActionBtn.BackgroundColor3 = Color3.fromRGB(0, 130, 240)
                end)
            end)
        end
    end
    
    if shownCount == 0 then
        local EmptyText = Instance.new("TextLabel")
        EmptyText.Size = UDim2.new(1, 0, 1, 0)
        EmptyText.BackgroundTransparency = 1
        EmptyText.Text = "Tidak ada file " .. currentTab
        EmptyText.TextColor3 = Color3.fromRGB(100, 110, 130)
        EmptyText.Font = Enum.Font.GothamMedium
        EmptyText.TextSize = 12
        EmptyText.Parent = FileList
    end
end

ScanBtn.MouseButton1Click:Connect(function()
    scannedFilesData = {}
    if not listfiles then
        ScanBtn.Text = "Executor tidak support listfiles!"
        ScanBtn.BackgroundColor3 = Color3.fromRGB(210, 60, 60)
        return
    end

    ScanBtn.Text = "Mencari file..."
    local success, files = pcall(function() return listfiles("workspace") end)
    if not success or type(files) ~= "table" then
        success, files = pcall(function() return listfiles("") end)
    end

    if success and type(files) == "table" then
        for _, filePath in ipairs(files) do
            local fileName = filePath:match("([^/\\]+)$") or filePath
            if fileName:match("%.rbxm$") or fileName:match("%.rbxl$") or fileName:match("%.rbxlx$") then
                table.insert(scannedFilesData, {name = fileName, path = filePath})
            end
        end
        ScanBtn.Text = "Scan Ulang (" .. #scannedFilesData .. " File)"
        ScanBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 240)
        renderFileList()
    else
        ScanBtn.Text = "Folder kosong / tidak terbaca"
        ScanBtn.BackgroundColor3 = Color3.fromRGB(210, 60, 60)
    end
end)
