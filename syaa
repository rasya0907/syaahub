    finishTw.Completed:Connect(function() IntroBlur:Destroy() end)
    
    -- Hilangkan stroke intro lebih cepat biar ga telat / ngeglitch
    TweenService:Create(IntroStroke, TweenInfo.new(0.2, Enum.EasingStyle.Linear), {Transparency = 1}):Play()

